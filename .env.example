# Application
APP_URL=http://localhost:3020
NODE_ENV=development
DEMO_MODE=false
SESSION_SECRET=
# Local owner cockpit. Keep both values outside version control.
OPS_OWNER_PASSWORD=
OPS_SESSION_SECRET=
# Optional private LAN operator. Run `npm run ops:enable-lan`; never expose this
# port through a router, public tunnel or Internet-facing reverse proxy.
OPS_LOCAL_ONLY=true
OPS_LAN_ENABLED=false
OPS_LAN_ORIGIN=
OPS_OPERATOR_USERNAME=operator
OPS_OPERATOR_PASSWORD=
# Runtime-backed settings. Real local execution uses app-server-stdio.
# app-server-stdio starts the local Codex app-server over stdio. It reuses the
# Windows user's `codex login` ChatGPT session; no API key, URL or bearer token
# belongs in this repository. Start it from that authenticated user session,
# not from an isolated/offline sandbox account.
OPS_CODEX_MODE=app-server-stdio
# Generate once with `npm run ops:ensure-connectors`; never commit the real value.
OPS_CONNECTOR_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
# Company OS multi-projets. Séparez plusieurs racines avec un point-virgule.
COMPANY_OS_PROJECT_ID=company-os
COMPANY_OS_PROJECT_NAME=Company OS
COMPANY_OS_PROJECT_ROOT=C:\Users\your-user\Documents\Codex\company-os
COMPANY_PROJECTS_ALLOWED_ROOTS=C:\absolute\authorized-root
COMPANY_PROJECTS_FORBIDDEN_ROOTS=C:\absolute\forbidden-root
# Optional explicit executable path when the installed Codex app binary cannot
# be spawned through PATH. Keep local copies under the ignored work/ directory.
OPS_CODEX_COMMAND=codex
OPS_CODEX_CEO_THREAD_ID=
# JSON object mapping each non-CEO agent id to its existing local Codex task id.
OPS_CODEX_AGENT_THREADS_JSON={}
OPS_SUPERVISOR_POLL_MS=500
OPS_SUPERVISOR_LEASE_MS=15000
OPS_EVENT_PURGE_INTERVAL_MS=3600000
# Model selections are allowlisted again in PostgreSQL before dispatch.
OPS_MODEL_RAPID=gpt-5.6-terra
OPS_MODEL_BALANCED=gpt-5.6-terra
OPS_MODEL_EXPERT=gpt-5.6-sol
OPS_MODEL_CRITICAL=gpt-5.6-sol
# Event/message retention (30 days), payload limits and orchestration budgets
# are enforced by schema/application policy and are not environment overrides.
CRON_SECRET=

# PostgreSQL / durable jobs
DATABASE_URL=postgresql://company_os:replace_with_url_safe_local_password@localhost:5434/company_os
DATABASE_SSL=false
POSTGRES_PASSWORD=
WORKER_CONCURRENCY=4

# Local short-form video rendering. It never publishes to social networks.
VIDEO_WORKER_POLL_MS=750
# Optional. Leave blank to auto-detect Chrome or Edge on Windows.
REMOTION_BROWSER_EXECUTABLE=

# S3-compatible local operational storage. One restricted bucket per project.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=company-os-system
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=company_os_local_only
MINIO_ROOT_PASSWORD=

# Operational caps
COMPANY_OS_MAX_PROJECTS=20
COMPANY_OS_MAX_GLOBAL_TURNS=4
COMPANY_OS_MAX_PROJECT_TURNS=2
COMPANY_OS_MAX_PROJECT_QUEUE=100
GLOBAL_EXTERNAL_WORK_ENABLED=false
